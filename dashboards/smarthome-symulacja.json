          "rawQuery": true,
          "rawSql": "SELECT \n  CASE category\n    WHEN 'simulation_10kwh_5kw' THEN '10 kWh / 5 kW (Standard)'\n    WHEN 'simulation_10kwh_10kw' THEN '10 kWh / 10 kW'\n    WHEN 'simulation_5kwh_5kw' THEN '5 kWh / 5 kW'\n    WHEN 'simulation_5kwh_10kw' THEN '5 kWh / 10 kW'\n  END AS \"Wariant\",\n  value AS \"Oszczędności (PLN)\"\nFROM metrics\nWHERE metric_name = 'sim_savings_pln'\n  AND category IN ('simulation_10kwh_5kw', 'simulation_10kwh_10kw', 'simulation_5kwh_5kw', 'simulation_5kwh_10kw')\n  AND \"timestamp\" = (SELECT MAX(\"timestamp\") FROM metrics WHERE metric_name = 'sim_savings_pln')\nORDER BY value DESC;",
          "refId": "A"
        }
      ],
      "title": "Ranking Oszczędności Całkowitych (PLN) - Porównanie Wariantów",
